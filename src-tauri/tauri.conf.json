{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Authly",
  "version": "0.3.13",
  "identifier": "dev.authapp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist-renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Authly",
        "width": 1040,
        "height": 720,
        "minWidth": 360,
        "minHeight": 560,
        "backgroundColor": "#07070a",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
