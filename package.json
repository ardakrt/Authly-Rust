{
  "name": "authapp",
  "version": "0.3.12",
  "private": true,
  "description": "Cross-platform, offline desktop authenticator for Windows and Linux",
  "desktopName": "Authly",
  "author": "Arda Kartal <ardakartaskisisel@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardakrt/Authly-Rust.git"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  },
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "start": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:web && npm run test:rust",
    "test:web": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "vite build",
    "tauri:build": "tauri build",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:web && npm run test:rust && npm run build:web"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@tauri-apps/api": "^2.5.0",
    "jsqr": "^1.4.0",
    "lucide-react": "1.71.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "^2.5.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "16.5.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  },
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=20.19.0"
  }
}
